# Non-secret deployment values. Copy this file to deploy.env on the VPS.
GHCR_OWNER=your-lowercase-github-owner
IMAGE_TAG=demo-latest
FRONTEND_ORIGIN=https://linear.smktelkom-sidoarjo.my.id
NEXT_PUBLIC_API_URL=https://api-linear.smktelkom-sidoarjo.my.id/api

# Adjust to the VPS capacity after checking free -h and nproc.
BACKEND_MEMORY_LIMIT=512m
BACKEND_CPU_LIMIT=0.75
FRONTEND_MEMORY_LIMIT=768m
FRONTEND_CPU_LIMIT=1.0

# Optional public Cloudinary name used in the browser bundle.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=h
